{
  "name": "yggdrasil-chronicles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:game\" \"npm:dev:server\"",
    "dev:game": "vite",
    "dev:server": "tsx --env-file-if-exists=.env watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "start": "node --env-file-if-exists=.env server-dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false && tsc -p server/tsconfig.json --noEmit",
    "validate:content": "tsx tools/validate-content.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "idb": "^8.0.3",
    "phaser": "^3.90.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
